# Variáveis de Ambiente - EXEMPLO
# Copie para .env e configure com seus valores

# Ambiente
NODE_ENV=production

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senhaSegura123
DB_NAME=kanban_db

# JWT - Gere uma chave segura (mínimo 32 caracteres)
JWT_SECRET=sua_chave_secreta_muito_segura_mude_em_producao_32chars_minimo

# Servidor
PORT=3000

# CORS - Domínios permitidos
CORS_ORIGIN=*
